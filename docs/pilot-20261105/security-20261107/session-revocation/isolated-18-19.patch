+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {createHash} from 'node:crypto';
+import worker from '../dist/server/index.js';
+function req(body,headers={},method='POST') {return new Request('https://test.example/csp-report',{method,headers:{'Content-Type':'application/csp-report',...headers},...(method==='GET'||method==='HEAD'?{}:{body,duplex:'half'})});}
+function safe(r,status) {assert.equal(r.status,status);assert.equal(r.headers.get('cache-control'),'no-store');for(const d of ["default-src 'none'","object-src 'none'","base-uri 'none'","frame-ancestors 'none'","report-uri /csp-report"])assert.ok(r.headers.get('content-security-policy').split(';').map(x=>x.trim()).includes(d));}
+const payload=JSON.stringify({'csp-report':{'effective-directive':'script-src-elem','document-uri':'https://private.test/?access_token=SYNTHETIC_SECRET','blocked-uri':'https://private.test/SYNTHETIC_SECRET','original-policy':'SYNTHETIC_SECRET','script-sample':'SYNTHETIC_SECRET','source-file':'SYNTHETIC_SECRET','status-code':200,disposition:'enforce'}});
+test('accepted reports emit only structured allowlisted fields',async()=>{
+ const logs=[],old=console.log;console.log=x=>logs.push(x);
+ try {const r=await worker.fetch(req(payload,{Origin:'https://test.example'}));safe(r,204);assert.equal(await r.text(),'');assert.deepEqual(logs.map(JSON.parse),[{event:'csp_violation',version:1,directive:'script-src-elem',disposition:'enforce',status:200}]);assert.ok(!logs.join('').includes('SYNTHETIC_SECRET'));} finally {console.log=old;}
+});
+test('report sink rejects malformed and cross-site input without logging',async()=>{
+ const logs=[],old=console.log;console.log=x=>logs.push(x);
+ try {
+  for(const [body,headers,status] of [[payload,{'Origin':'https://evil.example'},403],[payload,{'Sec-Fetch-Site':'cross-site'},403],[payload,{'Content-Type':'text/plain'},415],[payload,{'Content-Encoding':'gzip'},415],['{',{},400],['[]',{},400],['{}',{},400],[JSON.stringify({'csp-report':[]}),{},400],[JSON.stringify({'csp-report':{'effective-directive':'SYNTHETIC_SECRET'}}),{},400],[payload,{'Content-Length':'16385'},413],[payload,{'Content-Length':'bad'},413]])safe(await worker.fetch(req(body,headers)),status);
+  safe(await worker.fetch(req(null,{},'GET')),405);assert.deepEqual(logs,[]);
+ } finally {console.log=old;}
+});
+test('stream limit applies with missing and falsely small Content-Length',async()=>{
+ for(const headers of [{},{'Content-Length':'1'}]) {
+  let cancelled=false;
+  const body=new ReadableStream({start(c){c.enqueue(new Uint8Array(8192));c.enqueue(new Uint8Array(8192));c.enqueue(new Uint8Array(1));},cancel(){cancelled=true;}});
+  safe(await worker.fetch(req(body,headers)),413);assert.ok(cancelled);
+ }
+});
+test('exact byte limit accepts valid report and UTF-8 split across chunks',async()=>{
+ const base={'csp-report':{'effective-directive':'img-src','status-code':-1,disposition:'invalid'},ignored:'é'};
+ const value=JSON.stringify(base);const byteLength=new TextEncoder().encode(value).length;
+ base.ignored+='x'.repeat(16384-byteLength);
+ const bytes=new TextEncoder().encode(JSON.stringify(base));assert.equal(bytes.length,16384);
+ const logs=[],old=console.log;console.log=x=>logs.push(x);
+ try {
+  const stream=new ReadableStream({start(c){for(let i=0;i<bytes.length;i+=257)c.enqueue(bytes.slice(i,i+257));c.close();}});
+  safe(await worker.fetch(req(stream)),204);assert.equal(JSON.parse(logs[0]).status,0);assert.equal(JSON.parse(logs[0]).disposition,'enforce');
+ } finally {console.log=old;}
+});
+test('invalid UTF-8, stream error and timeout return bounded safe errors',async()=>{
+ safe(await worker.fetch(req(new Uint8Array([255]))),400);
+ safe(await worker.fetch(req(new ReadableStream({start(c){c.error(new Error('SYNTHETIC_SECRET'));}}))),400);
+ let cancelled=false;const started=Date.now();
+ safe(await worker.fetch(req(new ReadableStream({cancel(){cancelled=true;}}))),400);
+ assert.ok(cancelled);assert.ok(Date.now()-started<3500);
+});
+test('review fallback retains inline style via exact hash and self images without inline script allowance',async()=>{
+ const html=await readFile(new URL('../public/review.html',import.meta.url),'utf8');
+ const style=html.match(/<style>([\s\S]*?)<\/style>/i)[1];
+ const hash=createHash('sha256').update(style).digest('base64');
+ const r=await worker.fetch(new Request('https://test.example/review'));
+ assert.equal(r.status,200);const policy=r.headers.get('content-security-policy');
+ assert.ok(policy.includes(`style-src 'sha256-${hash}'`));assert.ok(policy.includes("img-src 'self'"));assert.ok(policy.includes("script-src 'none'"));assert.ok(!policy.includes('unsafe-inline'));
+});
+test('valid report logs are capped at10 per isolate minute; invalid reports do not consume slots',async()=>{
