diff --git a/scripts/csp-policy.mjs b/scripts/csp-policy.mjs
new file mode 100644
index 0000000..a7216d5
--- /dev/null
+++ b/scripts/csp-policy.mjs
@@ -0,0 +1,19 @@
+import { createHash } from 'node:crypto';
+export const REQUIRED_CSP = "object-src 'none'; base-uri 'none'; frame-ancestors 'none'; report-uri /csp-report";
+export const FALLBACK_CSP = `default-src 'none'; ${REQUIRED_CSP}`;
+// Build-time only: known static source, never user-supplied markup.
+export function assetPolicy(bytes, ext) {
+ if(ext!=='.html') return FALLBACK_CSP;
+ const html=bytes.toString();
+ const meta=html.match(/<meta\s+http-equiv="Content-Security-Policy"\s+content="([^"]+)"\s*\/?\s*>/i)?.[1];
+ let policy;
+ if(meta) {
+  policy=meta.split(';').map(s=>s.trim()).filter(s=>s && !/^(?:object-src|base-uri|frame-ancestors|report-uri|report-to)\s/i.test(s)).join('; ');
+ } else {
+  const hashes=tag=>[...html.matchAll(new RegExp(`<${tag}\\b[^>]*>([\\s\\S]*?)<\\/${tag}\\s*>`,'gi'))]
+   .filter(m=>m[1].trim()).map(m=>`'sha256-${createHash('sha256').update(m[1]).digest('base64')}'`);
+  const scripts=hashes('script'), styles=hashes('style');
+  policy=`default-src 'none'; script-src ${scripts.length?scripts.join(' '):"'none'"}; style-src ${styles.length?styles.join(' '):"'none'"}; img-src 'self'; connect-src 'none'; form-action 'none'`;
+ }
+ return `${policy}; ${REQUIRED_CSP}`;
+}
