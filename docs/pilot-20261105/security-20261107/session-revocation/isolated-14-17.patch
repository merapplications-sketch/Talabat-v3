+const assert=require('node:assert/strict');
+const mfa=require('../public/assets/mfa.js');
+function client(current='aal1',next='aal1',all=[]){return {auth:{mfa:{getAuthenticatorAssuranceLevel:async()=>({data:{currentLevel:current,nextLevel:next}}),listFactors:async()=>({data:{all}}),enroll:async()=>{throw Error('must not enroll');}}}};}
+(async()=>{
+ assert.equal(await mfa.ensure(client()),true);
+ const high=client('aal2','aal2');high.auth.mfa.listFactors=()=>{throw Error('not needed');};assert.equal(await mfa.ensure(high),true);
+ let prompted=0,hidden=0;const c=client('aal1','aal2',[{id:'factor',status:'verified',factor_type:'totp'}]);
+ assert.equal(await mfa.ensure(c,()=>hidden++,async(_,id)=>{assert.equal(id,'factor');prompted++;c.auth.mfa.getAuthenticatorAssuranceLevel=async()=>({data:{currentLevel:'aal2'}});return true;}),true);assert.equal(prompted,1);assert.equal(hidden,1);
+ for(const key of ['getAuthenticatorAssuranceLevel','listFactors']){const c=client();c.auth.mfa[key]=async()=>({error:{}});await assert.rejects(mfa.ensure(c));c.auth.mfa[key]=async()=>{throw Error();};await assert.rejects(mfa.ensure(c));}
+ await assert.rejects(mfa.ensure(client('aal1','aal2')));
+ await assert.rejects(mfa.ensure(client('aal1','aal2',[{id:'x',status:'verified',factor_type:'totp'}]),null,async()=>true));
+ let requests=0,release;const v=client('aal2','aal2');v.auth.mfa.challengeAndVerify=()=>{requests++;return new Promise(r=>release=r);};const verify=mfa.verifier(v,'factor');
+ for(const code of ['12345','1234567','abcdef','１２３４５６',' 123456',123456])assert.equal(await verify(code),false);
+ const pending=verify('123456');assert.equal(await verify('123456'),false);assert.equal(requests,1);release({});assert.equal(await pending,true);
+ // Minimal DOM proves opening setup never calls enroll; the click handler is not run.
+ class Node {constructor(){this.style={};this.children=[];}setAttribute(){}append(...n){this.children.push(...n);}addEventListener(){}focus(){}querySelectorAll(){return [];}replaceChildren(){this.children=[];}remove(){}}
