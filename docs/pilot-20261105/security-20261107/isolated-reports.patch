+  async function readMerchantReport(storeId, days) {
+    var end = new Date(), start = new Date(+end - Math.min(365, Math.max(1, Number(days) || 30)) * 86400000);
+    var cursor = 0, delivered = 0, cancelled = 0, revenue = 0, net = 0;
+    var cents = function (v) { var n = Number(v || 0); if (!Number.isFinite(n)) throw new Error('report_data'); return Math.round(n * 100); };
+    for (var page = 0; page < 100; page++) {
+      var r = await sb.from('orders').select('id,status,subtotal,discount,commission,points_value,cashback,fee_waived')
+        .eq('store_id', storeId).in('status', ['delivered', 'cancelled', 'rejected'])
+        .gte('done_at', start.toISOString()).lte('done_at', end.toISOString()).order('id', { ascending: true }).gt('id', cursor).limit(500);
+      if (r.error || !Array.isArray(r.data)) throw new Error('report_unavailable');
+      r.data.forEach(function (o) {
+        if (o.status === 'delivered') { delivered++; var base = cents(o.subtotal) - cents(o.discount); revenue += base; net += base - cents(o.commission) - cents(o.points_value) - cents(o.cashback) - cents(o.fee_waived); }
+        else cancelled++;
+      });
+      if (r.data.length < 500) return { delivered: delivered, cancelled: cancelled, revenue: revenue / 100, net: net / 100, from: start.toISOString(), to: end.toISOString() };
+      var next = r.data[r.data.length - 1].id;
+      if (!(Number(next) > Number(cursor))) throw new Error('report_cursor');
+      cursor = next;
+    }
+    throw new Error('report_too_large');
+  }
+  /* merchant report end */
@@ -1364,0 +1386,4 @@
