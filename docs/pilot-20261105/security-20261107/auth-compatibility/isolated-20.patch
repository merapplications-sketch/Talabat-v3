+const assert=require('node:assert/strict'),fs=require('node:fs'),vm=require('node:vm');
+const source=fs.readFileSync('public/talabat-core.js','utf8');
+const enter=source.slice(source.indexOf('  async function enter(user)'),source.indexOf('  function enterAuthorized(user)'));
+async function probe(need,id,mfa){let calls=0,authorized=0,failed=0;const ctx={need,window:{TLBMFA:mfa&&{ensure:async()=>{calls++;if(mfa==='fail')throw Error('offline');}}},sb:{},bootHide(){},bootFail(){failed++;},enterAuthorized(){authorized++;}};vm.createContext(ctx);vm.runInContext(enter+';this.run=enter;',ctx);await ctx.run({id});return {calls,authorized,failed};}
+(async()=>{
+ assert.deepEqual(await probe('customer','normal-customer',null),{calls:0,authorized:1,failed:0});
+ assert.deepEqual(await probe('customer','normal-customer','fail'),{calls:0,authorized:1,failed:0});
+ assert.deepEqual(await probe('customer','85fea11e-738c-4221-ac29-51d4ff50d594','fail'),{calls:1,authorized:0,failed:1});
+ assert.deepEqual(await probe('admin','test-admin','fail'),{calls:1,authorized:0,failed:1});
+ assert.deepEqual(await probe('admin','test-admin','ok'),{calls:1,authorized:1,failed:0});
+ console.log('5 customer/admin MFA scope regressions passed; no browser/device compatibility claim');
+})().catch(e=>{console.error(e);process.exitCode=1;});
